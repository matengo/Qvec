<Project>
  <PropertyGroup>
    <VersionPrefix>2.1.0</VersionPrefix>
    <Authors>matengo</Authors>
    <Description>Embedded AOT-oriented vector database library for .NET.</Description>
    <PackageTags>vector-database;embeddings;hnsw;ann;aot;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/matengo/Qvec</PackageProjectUrl>
    <RepositoryUrl>https://github.com/matengo/Qvec</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PackageId)' == ''">
    <PackageId>$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Qvec.Core.Client'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
