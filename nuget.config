<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Pin the restore sources to the repository rather than inheriting whatever feeds
       happen to be registered on the developer's machine. Combined with central package
       management this makes restore deterministic and identical to CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
